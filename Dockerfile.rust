ARG RUST_VERSION
FROM rust:${RUST_VERSION}-slim

ARG TARGETARCH
# renovate: datasource=github-releases depName=cargo-bins/cargo-binstall
ARG CARGO_BINSTALL_VERSION=1.26.0
# renovate: datasource=crate depName=cargo-edit
ARG CARGO_EDIT_VERSION=0.13.13
# renovate: datasource=crate depName=cargo-machete
ARG CARGO_MACHETE_VERSION=0.9.2
# renovate: datasource=crate depName=cargo-nextest
ARG CARGO_NEXTEST_VERSION=0.9.149
# renovate: datasource=crate depName=cargo-outdated
ARG CARGO_OUTDATED_VERSION=0.19.0
# renovate: datasource=crate depName=cargo-udeps
ARG CARGO_UDEPS_VERSION=0.1.61
# renovate: datasource=crate depName=cargo-watch
ARG CARGO_WATCH_VERSION=8.5.3
# renovate: datasource=crate depName=just
ARG JUST_VERSION=1.59.0
# renovate: datasource=crate depName=sqlx-cli
ARG SQLX_CLI_VERSION=0.9.0

SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
    'curl=8.14.*' \
    'git=1:2.47.*' \
    'mold=2.37.*' \
    'pkg-config=1.8.*' \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    rustup component add clippy rustfmt rust-analyzer rust-src \
    && case "$TARGETARCH" in \
        amd64) ARCH=x86_64 ;; \
        arm64) ARCH=aarch64 ;; \
        *) printf 'Unsupported architecture: %s\n' "$TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 --location --silent --show-error --fail \
    "https://github.com/cargo-bins/cargo-binstall/releases/download/v${CARGO_BINSTALL_VERSION}/cargo-binstall-${ARCH}-unknown-linux-musl.tgz" \
    | tar --extract --gzip --directory /usr/local/cargo/bin \
    && cargo binstall --no-confirm \
    "cargo-edit@${CARGO_EDIT_VERSION}" \
    "cargo-machete@${CARGO_MACHETE_VERSION}" \
    "cargo-nextest@${CARGO_NEXTEST_VERSION}" \
    "cargo-outdated@${CARGO_OUTDATED_VERSION}" \
    "cargo-udeps@${CARGO_UDEPS_VERSION}" \
    "cargo-watch@${CARGO_WATCH_VERSION}" \
    "just@${JUST_VERSION}" \
    "sqlx-cli@${SQLX_CLI_VERSION}"

WORKDIR /app
